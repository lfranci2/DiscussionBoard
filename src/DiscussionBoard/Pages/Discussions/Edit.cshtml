@page "{id}"
@model Edit

<div>
    <h1>Edit Discussion Thread</h1>

    <form method="post">
        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label for="title" asp-for="Input.Title"></label>
            <input id="title" asp-for="Input.Title" class="form-control" />
        </div>

        <div class="mb-3">
            <label for="content" asp-for="Input.Content"></label>
            <textarea id="content" asp-for="Input.Content"
                  class="form-control"
                  rows="6"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            Edit Discussion
        </button>
    </form>
</div>
