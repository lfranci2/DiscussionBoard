@page "/Discussion/{threadId}"
@using DiscussionBoard.Services
@using Microsoft.IdentityModel.Tokens
@model DiscussionBoard.Pages.Discussions.Details

<h1>@Model.Thread.Title</h1>

<div class="align-items-center mb-3">
    @if (string.IsNullOrWhiteSpace(Model.Thread.ApplicationUser?.DisplayName))
    {
        <p>
            Unconfigured User
        </p>
        <img src="@AvatarCatalog.ImagePath(AvatarCatalog.DefaultId)"
             alt="Unconfigured User avatar"
             class="rounded-circle"
             style="width: 25px; height: 25px; object-fit: cover;" />
    }
    else
    {
        <p>
            @Model.Thread.ApplicationUser.DisplayName
        </p>
        <img src="@AvatarCatalog.ImagePath(Model.Thread.ApplicationUser.AvatarId)"
             alt="@Model.Thread.ApplicationUser.DisplayName avatar"
             class="rounded-circle"
             style="width: 25px; height: 25px; object-fit: cover;" />
    }
</div>

<div class="card mb-4">
    @Model.Thread.Content
</div>

<h2>Posts</h2>

@if (Model.PostTree.Count == 0)
{
    <p>No posts yet. Start the conversation!</p>
}
else
{
    <div class="discussion-posts">
        @foreach (var post in Model.PostTree)
        {
            <partial name="/Pages/Discussions/_PostTree.cshtml" model="post" />
        }
    </div>
}
<h2>Create Post</h2>
<form method="post"
      asp-page="/Discussions/Details"
      asp-route-threadId="@Model.Thread.Id">

    <input type="hidden"
           asp-for="Input.ParentPostId"
           value="" />

    <div class="mb-3">
        <label asp-for="Input.Title"></label>
        <input asp-for="Input.Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Input.Content"></label>
        <textarea asp-for="Input.Content"
                  class="form-control"
                  rows="6"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        Create Post
    </button>
</form>
