@page "/Discussion/{threadId}"
@model DiscussionBoard.Pages.Discussions.Details

<h1>@Model.Thread.Title</h1>

<div class="card mb-4">
    @Model.Thread.Content
</div>

<h2>Posts</h2>

@if (Model.PostTree.Count == 0)
{
    <p>No posts yet. Start the conversation!</p>
}
else
{
    <div class="discussion-posts">
        @foreach (var post in Model.PostTree)
        {
            <partial name="/Pages/Discussions/_PostTree.cshtml" model="post" />
        }
    </div>
}
<h2>Create Post</h2>
<form method="post"
      asp-page="/Discussions/Details"
      asp-route-threadId="@Model.Thread.Id">

    <input type="hidden"
           asp-for="Input.ParentPostId"
           value="" />

    <div class="mb-3">
        <label asp-for="Input.Title"></label>
        <input asp-for="Input.Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Input.Content"></label>
        <textarea asp-for="Input.Content"
                  class="form-control"
                  rows="6"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        Create Post
    </button>
</form>
